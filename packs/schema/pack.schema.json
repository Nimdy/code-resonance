{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:code-resonance:visual-pack:v1",
  "title": "Code Resonance visual pack manifest (pack.json), SDK 1",
  "description": "Three kinds: 'declarative' (data only: parameters, palette, light, technique and effect mapping for an existing family, or an Artist Studio composition), 'shader' (custom GLSL background and post passes, optional procedural effects, on a built-in family) and 'world' (a complete world family implementing the World API). Shader and world packs contain code: they run isolated and only after the user approves them.",
  "type": "object",
  "required": ["schema", "id", "name", "version", "kind", "sdk"],
  "additionalProperties": false,
  "properties": {
    "$schema": {"type": "string", "maxLength": 200},
    "schema": {"const": "code-resonance.pack.v1"},
    "id": {"type": "string", "maxLength": 64, "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*(?:\\.[a-z0-9]+(?:-[a-z0-9]+)*)+$",
      "description": "Namespaced and stable: '<author>.<name>', lowercase, e.g. 'halcyon.cymatic-field'."},
    "name": {"$ref": "#/$defs/label"},
    "version": {"type": "string", "pattern": "^(0|[1-9][0-9]{0,4})\\.(0|[1-9][0-9]{0,4})\\.(0|[1-9][0-9]{0,4})$"},
    "kind": {"enum": ["declarative", "shader", "world"]},
    "sdk": {"type": "string", "pattern": "^\\^1\\.(0|[1-9][0-9]?)$", "description": "SDK compatibility: '^1.0' needs SDK 1.0 or a later 1.x."},
    "author": {"type": "object", "required": ["name"], "additionalProperties": false, "properties": {
      "name": {"$ref": "#/$defs/label"},
      "url": {"type": "string", "maxLength": 200, "pattern": "^https://[A-Za-z0-9._~:/?#@!$&'()*+,;=%-]+$"}}},
    "description": {"type": "string", "maxLength": 280},
    "license": {"type": "string", "pattern": "^[A-Za-z0-9.+-]{1,40}$"},
    "declarative": {"$ref": "#/$defs/declarative"},
    "shader": {"$ref": "#/$defs/shader"},
    "world": {"$ref": "#/$defs/world"}
  },
  "allOf": [
    {"if": {"properties": {"kind": {"const": "declarative"}}, "required": ["kind"]},
     "then": {"required": ["declarative"], "not": {"anyOf": [{"required": ["shader"]}, {"required": ["world"]}]}}},
    {"if": {"properties": {"kind": {"const": "shader"}}, "required": ["kind"]},
     "then": {"required": ["shader"], "not": {"anyOf": [{"required": ["declarative"]}, {"required": ["world"]}]}}},
    {"if": {"properties": {"kind": {"const": "world"}}, "required": ["kind"]},
     "then": {"required": ["world"], "not": {"anyOf": [{"required": ["declarative"]}, {"required": ["shader"]}]}}}
  ],
  "$defs": {
    "label": {"type": "string", "pattern": "^[\\p{L}\\p{N} .,'&()-]{1,40}$"},
    "name": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$", "maxLength": 32},
    "file": {"type": "string", "maxLength": 120, "pattern": "^(?!.*\\.\\.)[a-z0-9_-]+(?:/[a-z0-9_-]+)*\\.(?:js|glsl|frag|vert|json|md|txt|png|jpg)$"},
    "effectType": {"enum": ["subsystem.created", "module.created", "structure.created", "structure.removed", "subsystem.connected", "validation.failed",
      "validation.passed", "validation.recovered", "refactor.validated", "milestone.achieved", "repository.checkpoint", "world.expanded"]},
    "effects": {"type": "object", "propertyNames": {"$ref": "#/$defs/effectType"}, "additionalProperties": {"$ref": "#/$defs/name"},
      "description": "How each canonical intent is expressed: intent type -> effect name."},
    "trait": {"enum": ["modules", "districts", "symbols", "ui", "uiModules", "routes", "model", "functions", "dependencyDensity", "crossDensity", "hubness",
      "branching", "depth", "tests", "agents", "agentShare"]},
    "parameter": {"oneOf": [
      {"type": "object", "required": ["type", "min", "max"], "additionalProperties": false, "properties": {
        "type": {"enum": ["number", "integer"]}, "min": {"type": "number"}, "max": {"type": "number"}, "description": {"type": "string", "maxLength": 120},
        "from": {"type": "object", "required": ["trait"], "additionalProperties": false, "description": "Derive from a project trait: min + (max - min) * clamp(trait * scale + offset), plus seeded jitter.",
          "properties": {"trait": {"$ref": "#/$defs/trait"}, "scale": {"type": "number"}, "offset": {"type": "number"}, "jitter": {"type": "number", "minimum": 0, "maximum": 1}}}}},
      {"type": "object", "required": ["type", "values"], "additionalProperties": false, "properties": {
        "type": {"const": "enum"}, "values": {"type": "array", "minItems": 1, "maxItems": 16, "uniqueItems": true, "items": {"anyOf": [{"$ref": "#/$defs/name"}, {"type": "number"}]}},
        "weights": {"type": "array", "maxItems": 16, "items": {"type": "number", "minimum": 0}}, "description": {"type": "string", "maxLength": 120}}},
      {"type": "object", "required": ["type"], "additionalProperties": false, "properties": {
        "type": {"const": "boolean"}, "p": {"type": "number", "minimum": 0, "maximum": 1}, "description": {"type": "string", "maxLength": 120}}}
    ]},
    "technique": {"type": "object", "additionalProperties": false, "description": "Rendering technique, applied to the world's grade.", "properties": {
      "exposure": {"type": "number", "minimum": 0.5, "maximum": 2}, "bloom": {"type": "number", "minimum": 0, "maximum": 3},
      "contrast": {"type": "number", "minimum": 0.7, "maximum": 1.4}, "saturation": {"type": "number", "minimum": 0, "maximum": 2},
      "vignette": {"type": "number", "minimum": 0, "maximum": 2}, "grain": {"type": "number", "minimum": 0, "maximum": 3},
      "aberration": {"type": "number", "minimum": 0, "maximum": 0.02},
      "finish": {"enum": ["classic", "clean", "cinematic", "dreamlike"], "description": "The cinematic finish (SDK 1.2): classic is the world's own grade."},
      "tint": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "number", "minimum": 0.5, "maximum": 1.5}},
      "lift": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "number", "minimum": -0.05, "maximum": 0.05}}}},
    "budget": {"type": "object", "additionalProperties": false, "description": "What the pack promises to stay within at 1920x1080, full quality.", "properties": {
      "drawCalls": {"type": "integer", "minimum": 1, "maximum": 200}, "passes": {"type": "integer", "minimum": 1, "maximum": 64},
      "triangles": {"type": "integer", "minimum": 0, "maximum": 10000000}, "points": {"type": "integer", "minimum": 0, "maximum": 5000000},
      "textures": {"type": "integer", "minimum": 0, "maximum": 64}, "updateMs": {"type": "number", "minimum": 0.1, "maximum": 16}}},
    "declarative": {"type": "object", "required": ["base"], "additionalProperties": false, "properties": {
      "base": {"type": "string", "maxLength": 64, "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$", "description": "A built-in family or an installed world pack."},
      "overrides": {"type": "object", "maxProperties": 96, "propertyNames": {"pattern": "^[a-zA-Z]+(?:\\.[a-zA-Z0-9]+){0,2}$"},
        "additionalProperties": {"anyOf": [{"type": "number"}, {"type": "boolean"}, {"type": "string", "maxLength": 32},
          {"type": "array", "minItems": 2, "maxItems": 3, "items": {"type": "number"}}]},
        "description": "Genome parameter -> value, or [min, max] for a seeded value per project. Paths and ranges come from the base family's catalogue."},
      "effects": {"$ref": "#/$defs/effects"},
      "unlocks": {"type": "array", "maxItems": 8, "uniqueItems": true, "items": {"$ref": "#/$defs/name"}},
      "technique": {"$ref": "#/$defs/technique"},
      "composition": {"type": "object", "maxProperties": 32, "description": "An Artist Studio composition (SDK 1.2): procedural layers, mappings and finish, data only. The receiver validates it against the composition model (public/composition.js): allowlisted layer types and signals, bounded values, the rendering budget."}}},
    "shader": {"type": "object", "required": ["base"], "additionalProperties": false, "properties": {
      "base": {"enum": ["stellar-forge", "fractal-biosphere", "machine-cathedral", "synaptic-storm", "fractal-continuum", "temporal-terrain"]},
      "background": {"$ref": "#/$defs/file", "description": "A fragment shader replacing the family's background (sky, nebula)."},
      "post": {"type": "array", "maxItems": 4, "items": {"$ref": "#/$defs/file"}, "description": "Full-screen passes applied to the HDR scene before bloom and grade."},
      "effects": {"$ref": "#/$defs/file", "description": "An ES module with procedural effects (createEffects(sdk))."},
      "uniforms": {"type": "object", "maxProperties": 16, "propertyNames": {"pattern": "^u[A-Z][A-Za-z0-9]{0,30}$"}, "additionalProperties": {"$ref": "#/$defs/parameter"}},
      "overrides": {"$ref": "#/$defs/declarative/properties/overrides"},
      "technique": {"$ref": "#/$defs/technique"},
      "budget": {"$ref": "#/$defs/budget"}}},
    "world": {"type": "object", "required": ["entry", "effects", "ambient"], "additionalProperties": false, "properties": {
      "entry": {"$ref": "#/$defs/file"},
      "family": {"type": "object", "additionalProperties": false, "properties": {"name": {"$ref": "#/$defs/label"}}},
      "parameters": {"type": "object", "maxProperties": 64, "propertyNames": {"pattern": "^[a-z][A-Za-z0-9]{0,31}$"}, "additionalProperties": {"$ref": "#/$defs/parameter"}},
      "effects": {"$ref": "#/$defs/effects"},
      "ambient": {"type": "object", "required": ["unlocks"], "additionalProperties": false, "properties": {
        "base": {"type": "array", "maxItems": 16, "items": {"$ref": "#/$defs/name"}},
        "unlocks": {"type": "array", "maxItems": 8, "uniqueItems": true, "items": {"$ref": "#/$defs/name"}}}},
      "palette": {"type": "object", "additionalProperties": false, "properties": {
        "hues": {"type": "array", "minItems": 1, "maxItems": 16, "items": {"type": "number", "minimum": 0, "maximum": 360}}}},
      "shaders": {"type": "array", "maxItems": 32, "items": {"$ref": "#/$defs/file"}, "description": "GLSL files the world reads with sdk.assets.text()."},
      "textures": {"type": "array", "maxItems": 16, "items": {"$ref": "#/$defs/file"}},
      "budget": {"$ref": "#/$defs/budget"}}}
  }
}
